sys.assert(
  switch (1) {
    1: "one";
    2: "two";
    default: "fail";
  } == "one");

sys.assert(
  switch (4) {
    1: "one";
    2: "two";
    default: "fail";
  } == "fail");

sys.assert(
  switch (3) {
    1: "one";
    2, 3: "two or three";
    default: "fail";
  } == "two or three");

// Replacing 2 by 1 or 2 by 4, an exception will be raised.
sys.assert(
  switch (2) {
    1: sys.throw("Value is 1");
    2, 3: "two or three";
    default: sys.throw("Exception: value is not 1, 2 or 3.");
  } == "two or three");

