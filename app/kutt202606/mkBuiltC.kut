// NOTA: To create in '/home/deme/.dmCApp/kutt' 'built.h' and "lib/built.a',
//       'kutt' directory should be deleted.

:file libkutIncludePath = "/dm/dmC/lib/libkut/include/kut";
:file libkutSrcPath = "/dm/dmC/lib/libkut/src/kut";
Fs = [
    "thread", "opt", "arr", "bytes", "b64", "buf", "cryp", "exc",
    "time", "file", "tp", "tp3", "it", "kv", "map", "js", "math",
    "path", "regex", "rs", "str", "sys", "tcp"
  ];

createInterfaceH();
createInterfaceC();
createHeader();
createBody();
createInterfaceKut();

createInterfaceH = \ -> {
  :file dir = "c/h";
  :arr Fnames = dir.dir();
  Fnames.sort(\n1, n2 -> return n1 < n2;);
  file.write("c/interface.h", "");
  iface = file.aopen("c/interface.h");
  iface.writeText("\n// INTERFACE ----------------------------------------\n\n");

  for (fname = Fnames) {
    source = dir.cat([fname]).ropen();
    while () {
      lOp = source.readLine();
      if (!lOp) break;
      l = str.trim(lOp!);
      if (l == "" | l.starts("//")) continue;
      iface.writeText(l + "\n");
    }
    source.close();
    iface.writeText("\n");
  }
  iface.close();
};

createInterfaceC = \ -> {
  :file dir = "c/c";
  :arr Fnames = dir.dir();
  Fnames.sort(\n1, n2 -> return n1 < n2;);
  file.write("c/interface.c", "");
  iface = file.aopen("c/interface.c");
  iface.writeText("\n// INTERFACE ----------------------------------------\n\n");

  for (fname = Fnames) {
    iface.writeText(
      "\n// -------------------------------------\n" +
      "//" + fname[:-2] + "\n" +
      "// -------------------------------------\n\n"
    );

    source = dir.cat([fname]).ropen();
    while () {
      lOp = source.readLine();
      if (!lOp) break;
      l = str.trim(lOp!);
      if (l == "" | l.starts("//")) continue;
      iface.writeText(l + "\n");
    }
    source.close();
    iface.writeText("\n");
  }
  iface.close();
};

createHeader = \ -> {
  // [s.]
  :arr Bf = str.split(file.read("c/built.h"), "\n");
  for (f = Fs) {
    Bf
      .push("//")
      .push("// " + f + ".h ---------------------------------")
      .push("//")
    ;
    :arr Ls0 = str.split(libkutIncludePath.cat([f + ".h"]).read(), "\n");
    Ls1 = Ls0.dropWhile(\l -> return !str.trim(l).starts("#define"););
    Ls2 = Ls1.drop(1);
    Ls3 = Ls2.takeWhile(\l-> return str.trim(l) != "#endif";);
    for (l0 = Ls3) {
      l = str.trim(l0);
      if (
        l == "" |
        l.starts("//") |
        l.starts("#include") |
        l.starts("typedef") |
        l.starts("#define")
      ) continue;
      Bf.push(l0);
    }
  }
  Bf.cat(str.split(file.read("c/interface.h"), "\n"));

  tx0 = "// Code generated by mkBuiltC.\n\n" +
    "#include \"c/cheader.h\"\n\n" +
    "char *cheader_code (void) {\n" +
    "  return \"\"\n"
  ;

  file.write(
    "src/c/cheader.c",
    tx0 + Bf.map(\l -> return l + "\n";).map(js.ws).join("\n  ") + '\n;\n}\n'
  );
};

createBody = \ -> {
  // [s.]
  :arr Bf = str.split(file.read("c/built.c"), "\n");
  for (f = Fs) {
    Bf.push("//");
    Bf.push("// " + f + ".c ---------------------------------");
    Bf.push("//");
    :arr Ls = str.split(libkutSrcPath.cat([f + ".c"]).read(), "\n");
    for (l0 = Ls) {
      l = str.trim(l0);
      if (l.starts("#include")) continue;
      Bf.push(l0);
    }
  }
  Bf.cat(str.split(file.read("c/interface.c"), "\n"));

  tx0 = "// Code generated by mkBuiltC.\n\n" +
    "#include \"c/cheader.h\"\n\n" +
    "char *cbody_code (void) {\n" +
    "  return \"\"\n" +
    "  \"#include \\\"built.h\\\"\\n\"\n"
  ;
  file.write(
    "src/c/cbody.c",
    tx0 + Bf.map(\l -> return l + "\n";).map(js.ws).join("\n  ") + '\n;\n}\n'
  );
};

createInterfaceKut = \ -> {
  // [s.]
  :arr Bf = str.split(file.read("c/interface.c"), "\n");
  tx0 = "// Code generated by mkBuiltC.\n\n" +
    "char *interface_code (void) {\n" +
    "  return \"\"\n"
  ;
  file.write(
    "src/c/interface.c",
    tx0 + Bf.map(\l -> return l + "\n";).map(js.ws).join("\n  ") + '\n;\n}\n'
  );
};

